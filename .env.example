# Sanity — from https://www.sanity.io/manage
# Leave PUBLIC_SANITY_PROJECT_ID empty to build with the built-in sample products.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Free key from https://web3forms.com — the shortlist form emails you through it
PUBLIC_WEB3FORMS_KEY=

# Overrides site.config.ts siteName when set
PUBLIC_SITE_NAME=Moving sale

# Optional: Editor token from sanity.io/manage → API → Tokens
# Used by `npm run seed` and `npm run create-item`
SANITY_API_WRITE_TOKEN=

# Optional: salt for unique page-view hashing in the Worker (set as a Cloudflare secret)
# VIEW_SALT=
