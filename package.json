    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.11.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd@1.20261023.1": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260830.1",
