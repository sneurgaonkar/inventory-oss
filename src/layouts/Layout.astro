---
import Shortlist from '../components/Shortlist';
import { siteConfig } from '../../site.config';
interface Props {
  title?: string;
  description?: string;
  /** Large display heading in the header (homepage headline). Falls back to the site name. */
  heading?: string;
  /** Render the heading as the page's <h1> (homepage) or as a plain home link (item pages). */
  headingIsH1?: boolean;
  /** Short line under the heading (pickup note). */
  note?: string;
}
const site = import.meta.env.PUBLIC_SITE_NAME || siteConfig.siteName;
const {
  title = siteConfig.siteName,
  description = siteConfig.description,
  heading = site,
  headingIsH1 = false,
  note,
} = Astro.props;
const hasFilters = Astro.slots.has('filters');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F3F3F3" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400..700&family=Zalando+Sans+SemiExpanded:wght@500&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class:list={['site-header', { 'has-filters': hasFilters }]}>
      <div class="header-row">
        <div class="header-left">
          {headingIsH1
            ? <h1 class="site-title">{heading}</h1>
            : <a href="/" class="site-title site-title-link">{heading}</a>}
          {note && <p class="site-note">{note}</p>}
        </div>
        <div class="header-right">
          <Shortlist client:load web3formsKey={import.meta.env.PUBLIC_WEB3FORMS_KEY} />
        </div>
      </div>
      <slot name="stats" />
      {hasFilters && <div class="filter-bar"><slot name="filters" /></div>}
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <span>{site}</span>
      <span>All prices in {siteConfig.currencySymbol}</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --font-display: 'Zalando Sans SemiExpanded', 'Public Sans', system-ui, sans-serif;
    --font-body: 'Public Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --bg: #f3f3f3;
    --bg-header: rgba(243, 243, 243, 0.92);
    --card: #ffffff;
    --input-bg: #ebebeb;
    --mat: #ececec;
    --fg: #1a1a1a;
    --fg-2: #4a4a4a;
    --muted: #6e6e6e; /* 4.5:1 on #f3f3f3 and white */
    --line: #dcdcdc;
    --shadow: rgba(0, 0, 0, 0.06);
    --ok: #1f7a4d;
    --warn: #b7791f;
    --danger: #b42318;
    --pad-x: 40px;
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @media (max-width: 1024px) { :root { --pad-x: 32px; } }
  @media (max-width: 768px) { :root { --pad-x: 20px; } }
  @media (max-width: 480px) { :root { --pad-x: 16px; } }

  *, *::before, *::after { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; background: var(--bg); color: var(--fg);
    font: 400 16px/1.6 var(--font-body); letter-spacing: -0.01em;
    -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
    min-height: 100vh; display: flex; flex-direction: column;
  }
  main { flex: 1; }
  a { color: inherit; }
  img { display: block; max-width: 100%; }
  button { font: inherit; letter-spacing: inherit; }
  :focus-visible { outline: 2px solid var(--fg); outline-offset: 3px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .skip-link { position: absolute; left: 12px; top: -48px; z-index: 200; background: var(--fg); color: #fff; padding: 8px 14px; border-radius: 100px; font-size: 13px; text-decoration: none; }
  .skip-link:focus { top: 12px; }

  /* ---------- header ---------- */
  .site-header {
    position: sticky; top: 0; z-index: 100;
    background: var(--bg-header);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    padding: 28px var(--pad-x) 0;
  }
  .site-header:not(.has-filters) { padding-bottom: 20px; border-bottom: 1px solid var(--line); }
  .header-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; }
  .header-left { min-width: 0; }
  .site-title {
    font-family: var(--font-display); font-weight: 500; font-size: 44px; line-height: 1.15;
    letter-spacing: -0.03em; color: var(--fg); margin: 0; text-decoration: none; display: inline-block;
  }
  .site-title-link { font-size: 28px; transition: opacity 0.2s ease; }
  .site-title-link:hover { opacity: 0.7; }
  .site-note { margin: 6px 0 0; font-size: 14px; line-height: 1.45; color: var(--muted); max-width: 90ch; }
  .header-right { flex-shrink: 0; padding-top: 4px; }
  .filter-bar { padding: 16px 0 12px; }
  @media (max-width: 768px) {
    /* static on mobile, and no backdrop-filter so fixed bottom sheets inside it anchor to the viewport */
    .site-header { position: static; padding-top: 24px; backdrop-filter: none; -webkit-backdrop-filter: none; background: var(--bg); }
    .site-title { font-size: 32px; line-height: 1.1; }
    .site-title-link { font-size: 22px; }
    .site-note { font-size: 13px; }
    .header-right { padding-top: 0; }
    .filter-bar { padding: 14px 0 8px; margin: 0 calc(-1 * var(--pad-x)); }
  }

  /* ---------- pills (filters, pagination, badges) ---------- */
  .pill-row { display: flex; gap: 8px; align-items: center; }
  @media (max-width: 768px) {
    .pill-row { overflow-x: auto; padding: 2px var(--pad-x); scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .pill-row::-webkit-scrollbar { display: none; }
  }
  .pill {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px; white-space: nowrap; flex-shrink: 0;
    padding: 8px 16px; border: 1px solid var(--line); border-radius: 100px; background: transparent;
    font: 500 13px/1.2 var(--font-body); letter-spacing: -0.01em; color: var(--fg-2); text-decoration: none; cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }
  .pill svg { width: 15px; height: 15px; flex-shrink: 0; }
  .pill:hover { border-color: #a8a8a8; color: var(--fg); }
  .pill.active, .pill[aria-current='page'] { background: var(--fg); border-color: var(--fg); color: var(--bg); }
  @media (max-width: 480px) { .pill { padding: 7px 13px; font-size: 12.5px; } }

  /* ---------- buttons ---------- */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 44px; padding: 0 20px; border-radius: 100px; border: 1px solid var(--line);
    background: var(--card); color: var(--fg); cursor: pointer; text-decoration: none;
    font: 500 14px/1 var(--font-body); letter-spacing: -0.01em;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
  }
  .btn:hover { border-color: #a8a8a8; }
  .btn:active { transform: scale(0.98); }
  .btn.primary { background: var(--fg); color: #fff; border-color: var(--fg); }
  .btn.primary:hover { background: #333; border-color: #333; }
  .btn:disabled { opacity: 0.5; cursor: default; }
  .interest-count {
    display: inline-flex; align-items: center; height: 22px; padding: 0 9px; border-radius: 100px;
    font-size: 12px; font-weight: 600; white-space: nowrap; background: rgba(255, 255, 255, 0.18); color: inherit;
  }
  .btn:not(.primary) .interest-count { background: var(--input-bg); }

  /* Shortlist trigger: echoes the reference's segmented toggle */
  .shortlist-toggle {
    display: inline-flex; align-items: center; padding: 4px; border-radius: 100px; background: var(--input-bg);
    border: 0; cursor: pointer; color: var(--fg-2);
  }
  .shortlist-toggle .inner {
    display: inline-flex; align-items: center; gap: 7px; height: 34px; padding: 0 14px 0 12px; border-radius: 100px;
    background: var(--card); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06); font: 500 13px/1 var(--font-body);
    transition: color 0.2s ease;
  }
  .shortlist-toggle:hover .inner { color: var(--fg); }
  .shortlist-toggle svg { width: 15px; height: 15px; }
  .shortlist-toggle .count {
    min-width: 20px; height: 20px; padding: 0 6px; border-radius: 100px; background: var(--fg); color: #fff;
    font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; justify-content: center;
  }

  /* ---------- status badges ---------- */
  .status-badge {
    display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: 100px;
    background: rgba(255, 255, 255, 0.94); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
    font: 600 10.5px/1 var(--font-body); letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg);
  }
  .status-badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--muted); }
  .status-badge.reserved::before { background: var(--warn); }
  .status-badge.sold::before, .status-badge.given::before { background: var(--danger); }
  .status-badge[hidden] { display: none; }

  /* ---------- footer ---------- */
  .site-footer {
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    padding: 28px var(--pad-x) 36px; border-top: 1px solid var(--line); margin-top: 24px;
    font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
  }
</style>
