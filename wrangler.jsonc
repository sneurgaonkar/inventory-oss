{
  "name": "inventory-oss",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "persist": true, "invocation_logs": true },
    "traces": { "enabled": true, "persist": true, "head_sampling_rate": 1 }
  },
  "kv_namespaces": [
    // Create one: `npx wrangler kv namespace create INTEREST`
    // then paste the id here (and optionally under preview_id for `wrangler dev`).
    { "binding": "INTEREST", "id": "YOUR_KV_NAMESPACE_ID" }
  ]
}
